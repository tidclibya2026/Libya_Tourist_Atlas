@import "tailwindcss";
:root { color-scheme: light; --navy:#123f75; --navy-dark:#0c2a4d; --gold:#c4a15a; --ink:#20334c; --muted:#60718a; --line:#dce5ee; }
* {box-sizing:border-box} html {scroll-behavior:smooth} body {margin:0;background:#f7f9fc;color:var(--ink);font-family:Tahoma,Arial,sans-serif} button,input {font:inherit} button {cursor:pointer} a {text-decoration:none;color:inherit} a:focus-visible,button:focus-visible,input:focus-visible {outline:3px solid #d29f42;outline-offset:3px}
.visually-hidden {position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
.site-header {min-height:88px;display:flex;align-items:center;justify-content:space-between;gap:24px;background:white;border-bottom:1px solid var(--line);padding:15px max(5vw,24px);position:relative;z-index:3}.brand {display:flex;align-items:center;gap:12px;color:var(--navy)}.brand-mark {height:48px;width:48px;border:2px solid var(--gold);display:grid;place-items:center;border-radius:12px;font-weight:900;letter-spacing:1px}.brand strong {display:block;font-size:1rem}.brand small {display:block;font-size:.68rem;letter-spacing:1.2px;margin-top:4px}.top-links {display:flex;gap:25px;font-weight:600;font-size:.92rem}.top-links a:hover {color:#ae8533}.language-note {border:1px solid var(--line);padding:8px 13px;border-radius:9px;font-size:.85rem}
.hero {min-height:510px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:space-between;gap:30px;padding:70px max(6vw,24px);background:linear-gradient(120deg,#0b2849,#154b85 57%,#245f8e);color:white}.hero-pattern {position:absolute;inset:0;background:repeating-radial-gradient(circle at 80% 50%,transparent 0,transparent 55px,#ffffff0c 57px,#ffffff0c 58px);pointer-events:none}.hero-content {position:relative;max-width:720px;z-index:1}.eyebrow {font-size:.78rem;letter-spacing:.8px;color:#edc77d;font-weight:800;margin:0 0 13px}.eyebrow.dark {color:#9a742e}.hero h1 {font-size:clamp(2.65rem,6vw,5rem);font-weight:800;line-height:1.28;letter-spacing:-1px;margin:0}.hero h1 span {color:#e3c58d}.hero-copy {font-size:1.05rem;color:#e1ebf7;max-width:580px;line-height:2;margin:20px 0 28px}.search-box {display:flex;padding:6px;background:white;border-radius:15px;width:min(100%,600px);box-shadow:0 15px 32px #001a3452}.search-box input {flex:1;min-width:0;border:0;padding:14px;color:var(--ink);border-radius:12px}.search-box button {border:0;background:var(--gold);color:#1c3551;border-radius:10px;font-weight:800;padding:12px 24px}.hero-footnote {font-size:.76rem;color:#d9e3ef;margin:11px 0 23px}.hero-link {font-weight:700;border-bottom:1px solid #e3c58d;padding-bottom:5px}.hero-emblem {position:relative;z-index:1;flex-shrink:0;border:1px solid #e5c98777;border-radius:50%;width:245px;height:245px;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#ffffff0a;box-shadow:0 0 0 17px #ffffff08}.hero-emblem span {font-size:1.1rem;color:#f0d79b}.hero-emblem strong {font-size:5rem;line-height:1.1}.hero-emblem small {font-size:.85rem}
.section-wrap {max-width:1280px;margin:auto;padding:74px 25px}.section-heading {display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:25px}.section-heading h2,.map-section h2,.about-section h2 {margin:0 0 12px;font-size:clamp(1.55rem,3vw,2.3rem);color:var(--navy)}.section-heading p,.map-section p {margin:0;color:var(--muted);line-height:1.9}.count-chip {white-space:nowrap;color:var(--navy);background:#e7eff9;border-radius:30px;padding:9px 14px;font-size:.85rem;font-weight:700}.filter-bar {display:flex;flex-wrap:wrap;gap:9px;margin-bottom:26px}.filter {border:1px solid #cbd9e7;border-radius:30px;padding:9px 21px;background:white;color:var(--navy)}.filter.active {background:var(--navy);color:white;border-color:var(--navy)}.sector-grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.sector-card {display:flex;flex-direction:column;align-items:stretch;text-align:right;gap:14px;min-height:220px;background:white;border:1px solid var(--line);border-radius:18px;padding:25px;box-shadow:0 4px 15px #183a6010;transition:transform .15s,border-color .15s}.sector-card:hover {transform:translateY(-3px);border-color:#bda16d}.sector-top {display:flex;justify-content:space-between;align-items:center}.sector-icon {display:grid;place-items:center;width:46px;height:46px;border-radius:12px;background:#e8f1f9;color:var(--navy);font-size:1.55rem;font-weight:700}.sector-index {font-size:.9rem;color:#96a4b6}.sector-card strong {font-size:1.1rem;color:var(--navy)}.sector-summary {line-height:1.7;color:var(--muted);font-size:.9rem;flex:1}.sector-more {color:#a17c3a;font-weight:700;font-size:.83rem}.empty-state {padding:30px;background:white;border:1px solid var(--line);border-radius:15px}.detail-panel {position:relative;border:1px solid #c4a15a;border-right:5px solid #c4a15a;border-radius:16px;padding:25px;background:#fffdfa;margin-top:22px}.detail-panel h3 {font-size:1.35rem;color:var(--navy)}.detail-panel p {line-height:1.8}.detail-notice {color:#77613b}.close-button {position:absolute;left:15px;top:12px;border:0;background:#f0e9da;border-radius:7px;width:32px;height:32px;font-size:1.35rem}
.map-section {display:grid;grid-template-columns:1fr 1.2fr;gap:35px;align-items:center;background:#edf3f9;padding:75px max(6vw,25px)}.map-section p {max-width:510px}.status-pill {display:inline-block;margin-top:24px;background:#fff4d9;color:#85601f;border-radius:30px;padding:9px 15px;font-size:.83rem;font-weight:700}.map-placeholder {min-height:300px;border:2px dashed #9dbbd5;border-radius:18px;background:linear-gradient(135deg,#e2edf5,#cbdfea);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;color:var(--navy)}.map-placeholder>span {font-size:4rem;line-height:1}.map-placeholder strong {font-size:1.25rem}.map-placeholder small {max-width:240px;color:#506b87;line-height:1.8}.about-section {background:white;text-align:center;padding:74px 25px}.about-section p:last-child {max-width:820px;margin:0 auto;line-height:2;color:var(--muted)}.site-footer {display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap;background:var(--navy-dark);color:#ecf3fa;padding:30px max(6vw,25px);font-size:.85rem}
@media(max-width:900px){.top-links {display:none}.sector-grid {grid-template-columns:repeat(2,minmax(0,1fr))}.hero-emblem {width:180px;height:180px}.hero-emblem strong {font-size:3.8rem}.map-section {grid-template-columns:1fr}}
@media(max-width:620px){.site-header {min-height:76px}.brand strong {font-size:.84rem}.brand small {font-size:.55rem}.brand-mark {width:40px;height:40px}.hero {padding:60px 22px;min-height:510px}.hero-emblem {display:none}.sector-grid {grid-template-columns:1fr}.section-wrap {padding:55px 18px}.section-heading {align-items:flex-start;flex-direction:column}.sector-card {min-height:190px}.map-section {padding:55px 20px}.site-footer {flex-direction:column}.search-box button {padding:12px 18px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.sector-card{transition:none}}
